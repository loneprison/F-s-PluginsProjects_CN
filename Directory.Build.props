<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.i18n.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.i18n.props')" />
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.Category.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.Category.props')" />
  <!-- すべての構成に共通の設定 -->
  <PropertyGroup>
    <!-- 警告レベル 4 を設定 -->
    <WarningLevel>3</WarningLevel>
    
    <!-- 警告をエラーとして扱わない -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    
    <!-- C++言語標準 -->
    <LanguageStandard>stdcpp17</LanguageStandard>

    <!-- 標準準拠モード -->
    <ConformanceMode>true</ConformanceMode>

    <!-- global i18n build mode controlled by _tools/i18n_build.ps1
         CN        -> VS Build outputs CN only
         JP_ForCN  -> VS Build outputs JP_ForCN only
         Both      -> VS Build outputs both CN and JP_ForCN -->
    <FsI18nBuildMode Condition="'$(FsI18nBuildMode)'==''">JP_ForCN</FsI18nBuildMode>
    <FsI18nBuildMode Condition="'$(FsI18nBuildMode)'!='CN' and '$(FsI18nBuildMode)'!='JP_ForCN' and '$(FsI18nBuildMode)'!='Both'">JP_ForCN</FsI18nBuildMode>

    <!-- selected language for current build invocation -->
    <FsI18nLang Condition="'$(FsI18nLang)'=='' and '$(FsI18nBuildMode)'=='CN'">CN</FsI18nLang>
    <FsI18nLang Condition="'$(FsI18nLang)'=='' and '$(FsI18nBuildMode)'=='JP_ForCN'">JP_ForCN</FsI18nLang>
    <FsI18nLang Condition="'$(FsI18nLang)'=='' and '$(FsI18nBuildMode)'=='Both'">JP_ForCN</FsI18nLang>
    <FsI18nLang Condition="'$(FsI18nLang)'==''">JP_ForCN</FsI18nLang>

    <!-- normalized language suffix used by output naming -->
    <FsI18nLangSuffix Condition="'$(FsI18nLang)'=='CN'">CN</FsI18nLangSuffix>
    <FsI18nLangSuffix Condition="'$(FsI18nLang)'=='JP_ForCN'">JP_ForCN</FsI18nLangSuffix>
    <FsI18nLangSuffix Condition="'$(FsI18nLangSuffix)'==''">JP_ForCN</FsI18nLangSuffix>
  </PropertyGroup>

  <!-- Debug 構成のみの設定 -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <LocalDebuggerCommand>C:\Program Files\Adobe\Adobe After Effects 2024\Support Files\AfterFX.exe</LocalDebuggerCommand>
  </PropertyGroup>
  
  <!-- すべての構成に共通のコンパイル設定 -->
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- 特定の警告を無効化 -->
      <!-- 4103: alignment changed after including header
           4189: local variable is initialized but not referenced
           4505: unreferenced local function has been removed
           4996: deprecated functions
           4100: unreferenced formal parameter
           4458: declaration hides class member
           4456: declaration hides previous local declaration -->
      <DisableSpecificWarnings>4201;4103;4189;4505;4996;4100;4458;4456</DisableSpecificWarnings>
      
      <!-- セキュリティ警告を抑制 -->
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      
      <!-- 並列コンパイル -->
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      
      <!-- SDL チェックを無効化 -->
      <SDLCheck>false</SDLCheck>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Inject zh-CN localization macro only for CN output -->
  <ItemDefinitionGroup Condition="'$(FsI18nLang)'=='CN'">
    <ClCompile>
      <PreprocessorDefinitions>FS_LOCALIZE_ZH_CN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
